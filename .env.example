# Day 22 lab — env template. Copy to .env and fill in.
# Both tiers default to T4 (free Colab); flip COMPUTE_TIER to BIGGPU on A100/L4.

# ───────────────────────────────────────────────────────────
# Compute tier — picks model size, batch, dataset slice
# ───────────────────────────────────────────────────────────
COMPUTE_TIER=T4                     # T4 | BIGGPU

# T4   → Qwen2.5-3B-bnb-4bit, 2k pref pairs, max_length=512, batch=1 grad_accum=8
# BIGGPU → Qwen2.5-7B-bnb-4bit, 5k pref pairs, max_length=1024, batch=2 grad_accum=4

# ───────────────────────────────────────────────────────────
# Model + dataset overrides (optional — defaults set by COMPUTE_TIER)
# ───────────────────────────────────────────────────────────
# BASE_MODEL=unsloth/Qwen2.5-3B-bnb-4bit
# SFT_DATASET=bkai-foundation-models/vi-alpaca   # native VN Alpaca (org-approved)
# SFT_SLICE=1000                                 # NB1 trains on rows [:SFT_SLICE]
# PREF_DATASET=argilla/ultrafeedback-binarized-preferences-cleaned
# PREF_SLICE=2000                                # total preference pairs (T4); 5000 on BIGGPU

# NB2 builds a hybrid preference set: PREF_SLICE pairs total, split between
# English UltraFeedback and native-VN pairs rejection-sampled from SFT-mini
# against vi-alpaca rows [SFT_SLICE:SFT_SLICE+VN_POOL_SIZE]. Set to 0 to disable
# the native-VN step and fall back to English-only (faster, ~2 min NB2).
# VN_PREF_FRACTION=0.1
# VN_PREF_DATASET=bkai-foundation-models/vi-alpaca

# ───────────────────────────────────────────────────────────
# DPO hyperparameters (defaults match deck §5.2)
# ───────────────────────────────────────────────────────────
DPO_BETA=0.1
DPO_LR=5e-7
DPO_EPOCHS=1

# ───────────────────────────────────────────────────────────
# Optional: API judges for notebook 04 (only if you have keys)
# Without keys, notebook 04 falls back to manual rubric mode.
# ───────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# JUDGE_MODEL=gpt-4o-mini             # gpt-4o-mini | claude-haiku-4-5

# ───────────────────────────────────────────────────────────
# Optional: HuggingFace push (Submission Option B = +5 bonus)
# ───────────────────────────────────────────────────────────
# HF_TOKEN=hf_...
# HF_REPO=<your-username>/lab22-dpo-vn

# ───────────────────────────────────────────────────────────
# Optional: Weights & Biases (one of the +20 bonus rigor add-ons)
# ───────────────────────────────────────────────────────────
# WANDB_API_KEY=...
# WANDB_PROJECT=lab22-dpo
